{
  "schema": {
    "type": "object",
    "required": ["steps"],
    "additionalProperties": false,
    "properties": {
      "steps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["action", "target"],
          "properties": {
            "action": { "type": "string" },
            "target": { "type": "string", "maxLength": 200 }
          }
        }
      }
    }
  },
  "allow": [
    { "pointer": "/steps/*/action", "values": ["read", "summarize", "notify"] }
  ],
  "forbid_html": true,
  "max_bytes": 65536
}
